---
import { groupFacts } from '../data/companies';
---

<section id="overview" class="overview-section" aria-labelledby="overview-heading">
  <div class="wrap">
    <div class="overview-grid">
      <div class="overview-text reveal">
        <span class="label" data-i18n="ov.label">Group Overview</span>
        <h2 id="overview-heading" data-i18n="ov.title">
          An engineering partner for mission-critical special profiles in demanding industrial environments
        </h2>
        <p data-i18n="ov.p1">
          The Montanstahl Group currently has over 600 employees, with about 300 in Stabio (Canton of Ticino, Switzerland) and the remainder located across four production facilities in Schwerte (Germany), Talamona (Italy), Conroe (Texas, USA) and Tunica (Mississippi, USA) — as well as numerous commercial offices around the world.
        </p>
        <p data-i18n="ov.p2">
          The Group masters — often combining — six different production technologies: laser welding, hot rolling, hot extrusion, cold drawing, cold rolling and crimping. This integrated capability allows us manufacture with most complex steel shapes meeting the highest requirements and specifications.
        </p>
        <p data-i18n="ov.p3">
          Montanstahl Group profiles are used across numerous sectors such as construction, energy, offshore, nuclear, aerospace, defense, architecture, machinery, pharma and many more.
        </p>
      </div>

      <aside class="overview-side reveal" aria-label="Group capabilities">
        <div class="overview-card">
          <span class="card-eyebrow" data-i18n="ov.techLabel">Six production technologies</span>
          <ul class="tech-grid">
            <li data-i18n="tech.lw">Laser Welding</li>
            <li data-i18n="tech.he">Hot Extrusion</li>
            <li data-i18n="tech.hr">Hot Rolling</li>
            <li data-i18n="tech.dr">Cold Drawing</li>
            <li data-i18n="tech.cr">Cold Rolling</li>
            <li data-i18n="tech.pn">Crimping</li>
          </ul>
        </div>

        <div class="overview-card">
          <span class="card-eyebrow" data-i18n="ov.indLabel">Industries served</span>
          <div class="ind-list">
            <span data-i18n="ind.con">Construction</span>
            <span data-i18n="ind.ene">Energy</span>
            <span data-i18n="ind.off">Offshore</span>
            <span data-i18n="ind.nuc">Nuclear</span>
            <span data-i18n="ind.aero">Aerospace</span>
            <span data-i18n="ind.def">Defense</span>
            <span data-i18n="ind.arc">Architecture</span>
            <span data-i18n="ind.mach">Machinery</span>
            <span data-i18n="ind.phar">Pharma</span>
            <span data-i18n="ind.more">… and more</span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
