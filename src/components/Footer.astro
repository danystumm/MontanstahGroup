---
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap foot">
    <div class="foot-brand">
      <span class="mark" aria-hidden="true"></span>
      <strong>Montanstahl</strong>
      <span class="gp" data-i18n="foot.group">Group</span>
    </div>
    <div class="foot-meta">
      © {year} Montanstahl AG ·
      <span data-i18n="foot.rights">All rights reserved</span> ·
      <a href="https://www.montanstahl.com/privacy-notice/" target="_blank" rel="noopener" data-i18n="foot.privacy">Privacy</a>
    </div>
  </div>
</footer>
