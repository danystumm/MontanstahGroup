---
// Navigation bar with brand mark and language switcher
---

<nav class="nav" id="nav" aria-label="Primary">
  <div class="wrap nav-inner">
    <a href="#top" class="brand" aria-label="Montanstahl Group — home">
      <span class="mark" aria-hidden="true"></span>
      <strong>Montanstahl</strong>
      <span class="gp" data-i18n="brand.group">Group</span>
    </a>
    <div class="nav-links">
      <a href="#overview" data-i18n="nav.overview">Overview</a>
      <a href="#companies" data-i18n="nav.companies">Companies</a>
      <a href="#presence" data-i18n="nav.presence">Presence</a>
      <a href="#history" data-i18n="nav.history">History</a>
      <a href="#contact" data-i18n="nav.contact">Contact</a>
      <div class="lang-switch" role="group" aria-label="Language">
        <button data-lang="en" class="active" aria-label="English">EN</button>
        <button data-lang="it" aria-label="Italiano">IT</button>
        <button data-lang="de" aria-label="Deutsch">DE</button>
        <button data-lang="es" aria-label="Español">ES</button>
      </div>
    </div>
  </div>
